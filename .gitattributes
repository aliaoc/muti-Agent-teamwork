# 统一换行：仓库内文本一律 LF，Windows 脚本保持 CRLF 以便直接执行
* text=auto eol=lf

*.sh      text eol=lf
*.ps1     text eol=crlf
*.bat     text eol=crlf
*.md      text eol=lf
*.py      text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf

*.png     binary
*.jpg     binary
*.jpeg    binary
*.webp    binary
*.gif     binary
*.pdf     binary
